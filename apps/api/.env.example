NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://salary:salary@localhost:5440/salary_dev
CORS_ORIGIN=http://localhost:3000

# Single HR login. Generate the hash with:
#   npm run hash-password -w apps/api -- "<your password>"
ADMIN_EMAIL=hr@acme.example
ADMIN_PASSWORD_HASH=<bcrypt hash>
# At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random secret>
SESSION_TTL_HOURS=8
